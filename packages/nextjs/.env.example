# Copy to .env.local and fill in. Never commit .env.local.

# Privy (dashboard.privy.io). The App ID is public; the App Secret is server-only.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Operator key: pays gas for new users, verifies wallets, mints test Rupiah and deposits rent.
# Same wallet that deployed the contracts. Testnet only.
DEPLOYER_PRIVATE_KEY=

# Code typed on /operator to deposit rent.
OPERATOR_PASSCODE=

# Optional. Route browser RPC calls through this app's /api/rpc proxy (for networks that block the RPC domain).
# NEXT_PUBLIC_RPC_URL=https://YOUR-APP.vercel.app/api/rpc
# SERVER_RPC_URL=https://rpc.testnet.chain.robinhood.com
# GAS_DRIP_ETH=0.0003
